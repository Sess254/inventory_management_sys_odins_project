<!DOCTYPE html>
    <html>
    <head>
    <title>Sony Audio Inventory - Products</title>
    </head>
    <body>
    <h1>Products</h1>
    <a href="/products/new">Add New Product</a>
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>
        </thead>
        <tbody>
        <% products.forEach(product => { %>
            <tr>
            <td><%= product.name %></td>
            <td><%= product.category_name %></td>
            <td>$<%= product.price %></td>
            <td><%= product.stock %></td>
            <td><a href="/products/<%= product.id %>">View</a></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</body>
</html>